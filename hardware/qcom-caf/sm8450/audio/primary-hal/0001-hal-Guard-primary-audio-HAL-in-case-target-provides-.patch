 LOCAL_PATH := $(call my-dir)
 
 LOCAL_AUDIO_SERVICE_64 := taro parrot bengal holi blair
@@ -126,3 +127,4 @@ endif
 endif
 
 include $(BUILD_SHARED_LIBRARY)
+endif
