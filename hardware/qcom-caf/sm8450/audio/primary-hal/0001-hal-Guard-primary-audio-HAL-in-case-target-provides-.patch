 hal/Android.mk | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/hal/Android.mk b/hal/Android.mk
index cb037c4a..f53e78ff 100644
--- a/hal/Android.mk
+++ b/hal/Android.mk
